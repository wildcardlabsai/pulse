# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# FIGHT PULSE CANONICAL DATA PROVIDER SECRETS
# ==========================================

# 1. SUPABASE PERSISTENT DATA LAYER
# Required for PostgreSQL storage of fighters, events, historical results, odds snapshots
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# 2. THE ODDS API (v4) - free tier: 500 credits/month, https://the-odds-api.com
# SERVER-SIDE ONLY (no VITE_ prefix): read by the Vercel function in api/odds.ts
THE_ODDS_API_KEY="your-the-odds-api-key"

# 3. LIVE DATA SWITCH
# Set to "true" to make the app use live providers instead of built-in fixtures
VITE_ENABLE_LIVE_DATA="true"

# Not used (paid / no public API): Sportradar, CompuBox, Gemini
