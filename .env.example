# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# FIGHT PULSE CANONICAL DATA PROVIDER SECRETS
# ==========================================

# 1. SUPABASE PERSISTENT DATA LAYER
# Required for PostgreSQL storage of fighters, events, historical results, odds snapshots
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# 2. SPORTRADAR BOXING API (v2)
# Required for verified fighter profiles, daily fight schedules, and official results
SPORTRADAR_API_KEY="your-sportradar-api-key"
VITE_SPORTRADAR_API_KEY="your-sportradar-api-key"

# 3. THE ODDS API (v4)
# Required for real-time multi-bookmaker odds (Bet365, SkyBet, Betfair, etc.)
THE_ODDS_API_KEY="your-the-odds-api-key"
VITE_THE_ODDS_API_KEY="your-the-odds-api-key"

# 4. COMPUBOX TELEMETRY STREAM
# Required for live ringside punch statistics and second-by-second round telemetry
COMPUBOX_API_KEY="your-compubox-feed-key"
VITE_COMPUBOX_API_KEY="your-compubox-feed-key"
